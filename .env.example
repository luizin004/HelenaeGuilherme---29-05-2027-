# ============================================================
# Helena & Guilherme — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione .env.local.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publishable-anon
# Usada apenas no servidor (webhooks, jobs). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# URL pública do site (usada em links de pagamento e e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Asaas (pagamentos dos presentes)
# Sandbox: https://sandbox.asaas.com/api/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=sua-chave-asaas
# Token que valida a autenticidade do webhook do Asaas
ASAAS_WEBHOOK_TOKEN=defina-um-token-secreto
